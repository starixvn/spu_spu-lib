        /// <summary>
        /// Stop all tasks.
        /// </summary>
        public void Stop()
        {
            try
            {
                ThreadPool.StopAllTasks();

                OperationMessageQueue.ReceiveCompleted -= this.Mq_ReceiveCompleted;                
                OperationMessageQueue.Purge();
                OperationMessageQueue.Close();
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }        
